<mjml>
    <mj-include path="./layout/header.mjml" />

    <mj-body background-color="#000000">

        <!-- Main wrapper -->
        <mj-section background-color="#000000" padding="0">
            <mj-column>

                <!-- Top brand bar -->
                <mj-section background-color="#000000" padding="34px 32px 20px 32px">
                    <mj-column>
                        <mj-text
                            align="left"
                            color="#E50914"
                            font-size="32px"
                            font-weight="800"
                            letter-spacing="1px"
                            line-height="38px"
                            padding="0">
                            DragonDB
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- Hero section -->
                <mj-section background-color="#000000" padding="18px 32px 8px 32px">
                    <mj-column>
                        <mj-text
                            color="#FFFFFF"
                            font-size="30px"
                            font-weight="700"
                            line-height="38px"
                            padding="0 0 16px 0">
                            Your private media access is ready.
                        </mj-text>

                        <mj-text
                            color="#DADADA"
                            font-size="17px"
                            line-height="26px"
                            padding="0 0 18px 0">
                            {{ .hello }},
                        </mj-text>

                        <mj-text
                            color="#DADADA"
                            font-size="17px"
                            line-height="26px"
                            padding="0 0 10px 0">
                            You have been invited to join DragonDB, a private Jellyfin-powered media library.
                        </mj-text>

                        <mj-text
                            color="#BDBDBD"
                            font-size="15px"
                            line-height="24px"
                            padding="0 0 22px 0">
                            Use the secure invite link below to create your account and start watching.
                        </mj-text>

                        <mj-button
                            href="{{ .inviteURL }}"
                            background-color="#E50914"
                            color="#FFFFFF"
                            font-size="16px"
                            font-weight="700"
                            border-radius="4px"
                            inner-padding="15px 34px"
                            align="left"
                            padding="4px 0 28px 0">
                            Accept Invite
                        </mj-button>
                    </mj-column>
                </mj-section>

                <!-- Info card -->
                <mj-section background-color="#000000" padding="0 32px 24px 32px">
                    <mj-column
                        background-color="#141414"
                        border-radius="8px"
                        padding="22px 22px 18px 22px"
                        border="1px solid #2A2A2A">

                        <mj-text
                            color="#FFFFFF"
                            font-size="18px"
                            font-weight="700"
                            line-height="26px"
                            padding="0 0 10px 0">
                            Invite details
                        </mj-text>

                        <mj-text
                            color="#CFCFCF"
                            font-size="15px"
                            line-height="24px"
                            padding="0 0 8px 0">
                            {{ .inviteExpiry }}
                        </mj-text>

                        <mj-text
                            color="#8F8F8F"
                            font-size="13px"
                            line-height="21px"
                            padding="8px 0 0 0">
                            If the button does not work, copy and paste this link into your browser:
                        </mj-text>

                        <mj-text
                            color="#BDBDBD"
                            font-size="13px"
                            line-height="21px"
                            padding="6px 0 0 0"
                            word-break="break-all">
                            {{ .inviteURL }}
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- Help section -->
                <mj-section background-color="#000000" padding="0 32px 24px 32px">
                    <mj-column>
                        <mj-text
                            color="#AFAFAF"
                            font-size="14px"
                            line-height="22px"
                            padding="0">
                            Need help? Contact the DragonDB admin.
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- Footer -->
                <mj-section background-color="#000000" padding="22px 32px 34px 32px" border-top="1px solid #222222">
                    <mj-column>
                        <mj-text
                            color="#6F6F6F"
                            font-size="12px"
                            line-height="19px"
                            padding="0 0 8px 0">
                            This invitation was sent because someone invited you to access DragonDB.
                        </mj-text>

                        <mj-text
                            color="#6F6F6F"
                            font-size="12px"
                            line-height="19px"
                            padding="0">
                            {{ .footer }}
                        </mj-text>
                    </mj-column>
                </mj-section>

            </mj-column>
        </mj-section>

    </mj-body>
</mjml>