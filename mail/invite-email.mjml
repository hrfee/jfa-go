<mjml>
    <mj-include path="./layout/header.mjml" />

    <mj-body background-color="#0B0B10">

        <mj-include path="./layout/body-start.mjml" />

        <!-- Main email card -->
        <mj-section background-color="#0B0B10" padding="0">
            <mj-column width="560px" background-color="#111016" border-radius="14px" border="1px solid #2B213A">

                <!-- Hero section -->
                <mj-section background-color="#111016" padding="38px 30px 20px 30px" border-radius="14px 14px 0 0">
                    <mj-column>
                        <mj-text
                            color="#FFFFFF"
                            font-size="34px"
                            font-weight="800"
                            line-height="42px"
                            padding="0 0 6px 0">
                            Your DragonDB invite is ready.
                        </mj-text>

                        <mj-text
                            color="#D600FF"
                            font-size="26px"
                            font-weight="800"
                            line-height="34px"
                            padding="0 0 22px 0">
                            All in one app.
                        </mj-text>

                        <mj-text
                            color="#EDEAF5"
                            font-size="16px"
                            line-height="26px"
                            padding="0 0 14px 0">
                            {{ .hello }},
                        </mj-text>

                        <mj-text
                            color="#D8D2E6"
                            font-size="16px"
                            line-height="26px"
                            padding="0 0 12px 0">
                            You have been invited to join DragonDB, a private Jellyfin-powered media hub for watching, requesting, and exploring content.
                        </mj-text>

                        <mj-text
                            color="#AFA5C4"
                            font-size="15px"
                            line-height="24px"
                            padding="0 0 26px 0">
                            Create your account using the secure invite link below and start accessing your private media library.
                        </mj-text>

                        <mj-button
                            href="{{ .inviteURL }}"
                            background-color="#B517F2"
                            color="#FFFFFF"
                            font-size="16px"
                            font-weight="800"
                            border-radius="8px"
                            inner-padding="15px 34px"
                            align="left"
                            padding="0 0 24px 0">
                            Accept Invite
                        </mj-button>
                    </mj-column>
                </mj-section>

                <!-- Feature strip -->
                <mj-section background-color="#17131F" padding="26px 30px 24px 30px">
                    <mj-column>
                        <mj-text
                            align="center"
                            color="#FFFFFF"
                            font-size="20px"
                            font-weight="800"
                            line-height="28px"
                            padding="0 0 8px 0">
                            Watch. Request. Explore.
                        </mj-text>

                        <mj-text
                            align="center"
                            color="#AFA5C4"
                            font-size="14px"
                            line-height="22px"
                            padding="0 18px">
                            DragonDB keeps your private streaming experience clean, simple, and organized.
                        </mj-text>
                    </mj-column>
                </mj-section>

                <!-- Invite details -->
                <mj-section background-color="#111016" padding="26px 30px 28px 30px">
                    <mj-column background-color="#181321" border-radius="10px" border="1px solid #332247">
                        <mj-text
                            color="#FFFFFF"
                            font-size="18px"
                            font-weight="800"
                            line-height="26px"
                            padding="22px 22px 8px 22px">
                            Invite details
                        </mj-text>

                        <mj-text
                            color="#D8D2E6"
                            font-size="15px"
                            line-height="24px"
                            padding="0 22px 14px 22px">
                            {{ .inviteExpiry }}
                        </mj-text>

                        <mj-text
                            color="#8F84A5"
                            font-size="13px"
                            line-height="21px"
                            padding="0 22px 6px 22px">
                            If the button does not work, copy and paste this link into your browser:
                        </mj-text>

                        <mj-text
                            color="#B9A7D9"
                            font-size="13px"
                            line-height="21px"
                            padding="0 22px 22px 22px"
                            word-break="break-all">
                            {{ .inviteURL }}
                        </mj-text>
                    </mj-column>
                </mj-section>

            </mj-column>
        </mj-section>

        <mj-include path="./layout/body-end.mjml" />

    </mj-body>
</mjml>